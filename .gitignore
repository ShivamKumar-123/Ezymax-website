# Dependencies
node_modules/
**/node_modules/

# Next.js
.next/
out/
**/.next/

# Python
venv/
.venv/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
**/venv/

# Env & secrets (never commit)
.env
.env.*
!.env.example
*.pem

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
.cursor/

# Logs & debug
*.log
*.txt.log
admin_logs.txt
npm-debug.log*
yarn-debug.log*

# Upload storage (use object storage in production).
# backend/uploads/ holds real KYC documents + deposit proofs — NEVER commit.
# (Already covered by **/uploads/ below; listed explicitly for clarity.
# backend/uploads/banners/.gitkeep stays tracked — it predates the ignore.)
/uploads/
**/uploads/
backend/uploads/

# Database backups
/backups/

# Test / coverage
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/

# Build
dist/
build/
*.egg-info/

# Misc
*.local
*.tsbuildinfo

# Claude Code agent state (never commit)
.claude/

# Local working notes (extracted client doc text, scratch files)
.clientdocs/

# Binary specs / drafts / office docs — kept locally, not tracked
*.docx
*.doc
*.pdf
*.xlsx
*.xls
*.ppt
*.pptx
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
*.bak
~$*

# Client reference mockups dropped at the repo root (kept locally only)
/ChatGPT Image*.png
/ChatGPT Image*.jpg
ezymex_web/

# Source APK drop-zone — redundant with the served copy at
# frontend/trader/public/downloads/ezymex1.apk. Keep locally, don't track.
# (Scoped to the root folder only so the served public/ APK stays tracked.)
/apk/

backend/services/market_data/

# Machine-local Compose overrides (host port remaps etc.) — never shared,
# because what is free on one machine is taken on another.
docker-compose.override.yml

# Encrypted database dumps written by scripts/backup.sh. Never tracked:
# they are the whole database, and on the server /opt/ezymex is a git
# checkout that deploy.sh pulls into — a stray `git clean` there must not
# be able to take the backups with it.
/backups/

# Runtime uploads (KYC documents, deposit proofs, banners, tenant
# branding). User data, not source. The .gitkeep below preserves the
# directory so the bind mount has something to attach to.
backend/uploads/*
!backend/uploads/.gitkeep
!backend/uploads/*/
backend/uploads/*/*
!backend/uploads/*/.gitkeep
