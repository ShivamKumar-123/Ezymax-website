# =============================================================
# EZYMEX website - environment overview
# The website reads apps/trader/.env.local in development (copy the block below).
# Production public values are committed in apps/trader/.env.production; secrets go in
# apps/trader/.env.production.local on the server (deploy/deploy-website.sh in the Ezymex repo writes them).
# =============================================================

# ---- apps/trader/.env.local (website) ----
# NEXT_PUBLIC_BRAND_NAME=Ezymex
# NEXT_PUBLIC_BRAND_DOMAIN=ezymex.com
# NEXT_PUBLIC_SITE_URL=https://ezymex.com
# NEXT_PUBLIC_BRAND_SUPPORT_EMAIL=support@ezymex.com
# Ezymex Client Area: every "Log in" / "Sign up" / "Open account" goes here (default https://app.ezymex.com)
# NEXT_PUBLIC_CRM_URL=https://app.ezymex.com
# Ezymex Trader (default https://trade.ezymex.com)
# NEXT_PUBLIC_TRADER_URL=https://trade.ezymex.com
# Public market data: live prices on /markets and /options (default https://api.ezymex.com)
# NEXT_PUBLIC_MARKET_API=https://api.ezymex.com

# Server-side only (never NEXT_PUBLIC): the platform's news service, for the homepage market-news ticker.
# Without them the ticker shows a link to the economic calendar instead.
# NEWS_URL=http://127.0.0.1:8103
# NEWS_INTERNAL_TOKEN=<same value as NEWS_INTERNAL_TOKEN in the Ezymex repo's .env.local>
