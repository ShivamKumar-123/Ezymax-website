# SwissCresta — example environment file.
#
# Copy to `.env` and fill in real values. NEVER put real credentials in
# this file: `.env.example` is committed to git; `.env` is gitignored.
# Generate strong secrets with:  openssl rand -hex 32   (JWT secrets)
#                                openssl rand -base64 24 (passwords)

# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=swisscresta
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=swisscresta

# ─── TimescaleDB ──────────────────────────────────────────────
TIMESCALE_USER=swisscresta
TIMESCALE_PASSWORD=CHANGE_ME
TIMESCALE_DB=marketdata

# ─── Connection URLs (must match passwords above) ─────────────
DATABASE_URL=postgresql+asyncpg://swisscresta:CHANGE_ME@postgres:5432/swisscresta
TIMESCALE_URL=postgresql+asyncpg://swisscresta:CHANGE_ME@timescaledb:5432/marketdata
REDIS_URL=redis://redis:6379/0
ADMIN_REDIS_URL=redis://redis:6379/1

# ─── JWT secrets (openssl rand -hex 32; each one DIFFERENT) ───
# Production boot refuses empty/short/known-placeholder values.
JWT_SECRET=
USER_JWT_SECRET=
ADMIN_JWT_SECRET=
JWT_ACCESS_EXPIRY_MINUTES=45
JWT_REFRESH_EXPIRY_DAYS=7
# true = browser-session cookies (close browser → log in again)
JWT_REFRESH_SESSION_COOKIE=false

# ─── Cookies (production HTTPS) ───────────────────────────────
COOKIE_SAMESITE=lax
COOKIE_SECURE=true
# Parent domain so the session works on apex + trade subdomain.
# Local dev: leave blank (host-only cookies on localhost are correct).
COOKIE_DOMAIN=.swisscresta.com

# ─── Environment & CORS ───────────────────────────────────────
ENVIRONMENT=production
CORS_ORIGINS=https://swisscresta.com,https://www.swisscresta.com,https://trade.swisscresta.com,https://admin.swisscresta.com
TRADER_APP_URL=https://trade.swisscresta.com
NEXT_PUBLIC_MARKETING_HOST=swisscresta.com
NEXT_PUBLIC_TRADE_HOST=trade.swisscresta.com

# ─── Risk engine ──────────────────────────────────────────────
MARGIN_CALL_LEVEL=80.0
STOP_OUT_LEVEL=50.0
MAX_OPEN_TRADES=200
DEFAULT_LEVERAGE=100

# ─── Per-user spreads ─────────────────────────────────────────
# Apply user-scope spread_configs (admin "Per User (Override)" rows) to
# order fills. The /ws/prices stream always shows the user their own
# spread; enable this so fills charge it too (display and execution match).
USER_SPREAD_AT_EXECUTION=true

# ─── HTTP hardening ───────────────────────────────────────────
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type,X-Requested-With,Accept
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_TRADING=120/minute
MAX_REQUEST_SIZE=10485760

# ─── Sentry (leave DSN empty to disable) ──────────────────────
# SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ─── SMTP (password reset / notification email) ───────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SwissCresta <support@example.com>

# ─── Optional integrations ────────────────────────────────────
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=false
NOWPAYMENTS_CALLBACK_BASE_URL=https://api.swisscresta.com
TRON_API_URL=https://api.trongrid.io
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ─── Market data (Infoway.io; empty = crypto-only fallback) ───
INFOWAY_API_KEY=
INFOWAY_API_URL=https://api.infoway.io

# ─── Admin seed (alembic revision 0002) ───────────────────────
# NO default password: generate with `openssl rand -base64 24`.
# Migration 0002 refuses to seed if empty or a historical example value;
# production boot refuses known-weak values (packages/common/src/config.py).
ADMIN_EMAIL=admin@swisscresta.com
ADMIN_PASSWORD=

# ─── Razorpay (INR card/UPI deposits) ─────────────────────────
# Dashboard → Settings → API Keys / Webhooks. Leave empty to disable.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
USD_TO_INR_RATE=95

# ─── OxaPay (legacy crypto PSP) ───────────────────────────────
OXAPAY_MERCHANT_KEY=
OXAPAY_CALLBACK_BASE_URL=https://api.swisscresta.com

# ─── Crypto deposit verification (all optional) ───────────────
ETHERSCAN_API_KEY=
BSCSCAN_API_KEY=
TRONGRID_API_KEY=
ALCHEMY_API_URL=
BSC_RPC_URL=

# ─── Backups ──────────────────────────────────────────────────
BACKUP_LOCAL_DIR=/opt/swisscresta/backups
BACKUP_RETENTION_DAYS=14
BACKUP_RCLONE_REMOTE=
# MUST be set in production — backups contain KYC docs + PII.
BACKUP_GPG_PASSPHRASE=

# ── White-label brokers (rental model) ──────────────────────────────
# Master switch. When false the Brokers/Branding admin pages 503 and
# signup/login tenant attribution is a no-op.
BRANDING_ENABLED=false
# Hostnames that are the platform's own (never attributed to a tenant).
PLATFORM_HOSTS=swisscresta.com,www.swisscresta.com,trade.swisscresta.com,localhost,127.0.0.1
# Origin IP tenants must point their A records at (shown in the domain
# wizard, checked by DNS verification). REQUIRED for custom domains.
PLATFORM_PUBLIC_IP=
# Server-side SSL provisioning. Leave the tenants file empty on dev —
# the provisioner then records status transitions without running
# nginx/certbot. On the prod host, create the file once and add
#   include /etc/nginx/conf.d/swisscresta-tenants.conf;
# to nginx.conf's http block, plus passwordless sudo for certbot+nginx.
BRANDING_NGINX_TENANTS_FILE=
# Prod compose publishes trader on 127.0.0.1:3012 and admin on
# 127.0.0.1:3013 (see docker-compose.prod.yml) — set BOTH on the server.
# Every tenant domain also serves their admin panel on admin.<domain>.
BRANDING_TRADER_UPSTREAM=127.0.0.1:3012
BRANDING_ADMIN_UPSTREAM=127.0.0.1:3013
BRANDING_CERTBOT_BIN=/usr/bin/certbot
BRANDING_NGINX_BIN=/usr/sbin/nginx
BRANDING_CERTBOT_EMAIL=
# Containerised admin-api (default) hands nginx/certbot work to the HOST
# agent — install once with: sudo ./scripts/install-wl-agent-cron.sh
# Set true ONLY if admin-api runs directly on the host with sudo rights.
BRANDING_PROVISION_LOCAL=false

# ── AI Strategy Builder ─────────────────────────────────────────────
# Claude API key for natural-language strategy generation. Optional:
# without it the builder still works via manual JSON editing + backtests.
ANTHROPIC_API_KEY=
AI_STRATEGY_MODEL=claude-opus-5
