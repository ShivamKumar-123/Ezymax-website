[Unit]
Description=Kalks market-data service (:8081)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=kalks
WorkingDirectory=/home/kalks/kalks/services/market-data
EnvironmentFile=/home/kalks/kalks/.env.local
Environment=RUST_LOG=info
ExecStart=/home/kalks/kalks/target/release/market-data
Restart=always
RestartSec=3
NoNewPrivileges=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
