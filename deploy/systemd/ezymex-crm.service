[Unit]
Description=Ezymex Client Area (:3000)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=ezymex
WorkingDirectory=/home/ezymex/ezymex/apps/crm
Environment=NODE_ENV=production
ExecStart=/home/ezymex/ezymex/apps/crm/node_modules/.bin/next start -p 3000 -H 127.0.0.1
Restart=always
RestartSec=3
NoNewPrivileges=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
