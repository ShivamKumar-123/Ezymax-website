[Unit]
Description=Ezymex Trader (:3002)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=ezymex
WorkingDirectory=/home/ezymex/ezymex/apps/terminal
Environment=NODE_ENV=production
ExecStart=/home/ezymex/ezymex/apps/terminal/node_modules/.bin/next start -p 3002 -H 127.0.0.1
Restart=always
RestartSec=3
NoNewPrivileges=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
