[Unit]
Description=Kalks prop firm service (:8097)
After=network-online.target postgresql.service kalks-trading.service
Wants=network-online.target

[Service]
User=kalks
WorkingDirectory=/home/kalks/kalks/services/prop
EnvironmentFile=/home/kalks/kalks/.env.local
Environment=RUST_LOG=info
Environment=PROP_ENV=production
Environment=PROP_BIND=127.0.0.1:8097
Environment=PROP_VERIFY_BASE_URL=https://app.kalkstrade.com/verify
ExecStart=/home/kalks/kalks/target/release/prop
Restart=always
RestartSec=3
# the evaluator is stateless between polls; every transition is claimed in the database first
KillSignal=SIGINT
TimeoutStopSec=20
NoNewPrivileges=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
