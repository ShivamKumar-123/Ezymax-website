[Unit]
Description=Kalks DEMO Kalks Trader (:4002, mock showcase)
After=network-online.target
Wants=network-online.target

[Service]
User=kalks
WorkingDirectory=/home/kalks/kalks-demo/apps/terminal
Environment=NODE_ENV=production
ExecStart=/home/kalks/kalks-demo/apps/terminal/node_modules/.bin/next start -p 4002 -H 127.0.0.1
Restart=always
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
