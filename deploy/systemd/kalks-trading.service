[Unit]
Description=Kalks trading engine (:8090)
After=network-online.target postgresql.service kalks-market-data.service
Wants=network-online.target

[Service]
User=kalks
WorkingDirectory=/home/kalks/kalks/services/trading
EnvironmentFile=/home/kalks/kalks/.env.local
Environment=RUST_LOG=info
Environment=TRADING_ENV=production
Environment=TRADING_BIND=127.0.0.1:8090
ExecStart=/home/kalks/kalks/target/release/trading
Restart=always
RestartSec=3
# let in-flight commits finish; state is rebuilt from the event store on start
KillSignal=SIGINT
TimeoutStopSec=20
NoNewPrivileges=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
