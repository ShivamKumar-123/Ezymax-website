[Unit]
Description=Kalks reports service: statements, analytics, broker reports (:8102)
After=network-online.target postgresql.service kalks-trading.service kalks-gateway.service
Wants=network-online.target

[Service]
User=kalks
WorkingDirectory=/home/kalks/kalks/services/reports
EnvironmentFile=/home/kalks/kalks/.env.local
Environment=RUST_LOG=info
Environment=REPORTS_ENV=production
Environment=REPORTS_BIND=127.0.0.1:8102
Environment=REPORTS_COMPANY_SITE=kalkstrade.com
ExecStart=/home/kalks/kalks/target/release/reports
Restart=always
RestartSec=3
# every mirrored row is an idempotent upsert; a stop mid-pass is picked up by the next pass
KillSignal=SIGINT
TimeoutStopSec=20
NoNewPrivileges=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
