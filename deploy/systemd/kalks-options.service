[Unit]
Description=Kalks FX Options: reference data, listings, fixings, chain (:8104)
After=network-online.target postgresql.service kalks-market-data.service
Wants=network-online.target

[Service]
User=kalks
WorkingDirectory=/home/kalks/kalks/services/options
EnvironmentFile=/home/kalks/kalks/.env.local
Environment=RUST_LOG=info
Environment=OPTIONS_ENV=production
Environment=OPTIONS_BIND=127.0.0.1:8104
Environment=OPTIONS_HOLIDAYS_DIR=/home/kalks/kalks/config/holidays
ExecStart=/home/kalks/kalks/target/release/options
Restart=always
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=10
NoNewPrivileges=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
