[Unit]
Description=Kalks support chat, AI help bot and notifications (:8100)
After=network-online.target postgresql.service kalks-gateway.service
Wants=network-online.target

[Service]
User=kalks
WorkingDirectory=/home/kalks/kalks/services/support
EnvironmentFile=/home/kalks/kalks/.env.local
EnvironmentFile=-/home/kalks/kalks/.env.claude
Environment=RUST_LOG=info
Environment=SUPPORT_ENV=production
Environment=SUPPORT_BIND=127.0.0.1:8100
ExecStart=/home/kalks/kalks/target/release/support
Restart=always
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=20
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
