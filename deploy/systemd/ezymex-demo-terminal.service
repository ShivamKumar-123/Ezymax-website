[Unit]
Description=Ezymex DEMO Ezymex Trader (:4002, mock showcase)
After=network-online.target
Wants=network-online.target

[Service]
User=ezymex
WorkingDirectory=/home/ezymex/ezymex-demo/apps/terminal
Environment=NODE_ENV=production
ExecStart=/home/ezymex/ezymex-demo/apps/terminal/node_modules/.bin/next start -p 4002 -H 127.0.0.1
Restart=always
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
