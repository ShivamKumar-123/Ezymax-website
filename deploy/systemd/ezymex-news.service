[Unit]
Description=Ezymex news + economic calendar (:8103)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=ezymex
WorkingDirectory=/home/ezymex/ezymex/services/news
EnvironmentFile=/home/ezymex/ezymex/.env.local
# Claude key for the daily AI market brief (optional: the brief is skipped without it)
EnvironmentFile=-/home/ezymex/ezymex/.env.claude
Environment=RUST_LOG=info
Environment=NEWS_ENV=production
Environment=NEWS_BIND=127.0.0.1:8103
ExecStart=/home/ezymex/ezymex/target/release/news
Restart=always
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=10
NoNewPrivileges=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
