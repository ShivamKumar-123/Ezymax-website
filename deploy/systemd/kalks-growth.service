[Unit]
Description=Kalks growth: rewards and marketing (:8101)
After=network-online.target postgresql.service kalks-gateway.service kalks-trading.service kalks-wallet.service
Wants=network-online.target

[Service]
User=kalks
WorkingDirectory=/home/kalks/kalks/services/growth
EnvironmentFile=/home/kalks/kalks/.env.local
Environment=RUST_LOG=info
Environment=GROWTH_ENV=production
Environment=GROWTH_BIND=127.0.0.1:8101
ExecStart=/home/kalks/kalks/target/release/growth
Restart=always
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=20
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
