# Kalks production edge (Caddy). HTTPS certificates are issued and renewed automatically.
{
	email admin@kalkstrade.com
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# Client Area (CRM)
app.kalkstrade.com {
	import common
	reverse_proxy 127.0.0.1:3000
}

# Kalks Trader. /engine/stream = trading-engine account stream (one-time ticket from the terminal BFF).
trade.kalkstrade.com {
	import common
	handle /engine/stream {
		rewrite * /v1/terminal/stream?{query}
		reverse_proxy 127.0.0.1:8090
	}
	handle {
		reverse_proxy 127.0.0.1:3002
	}
}

# Back Office. /engine/stream = trading-engine dealing stream (one-time ticket from the admin BFF).
admin.kalkstrade.com {
	import common
	handle /engine/stream {
		rewrite * /v1/dealing/stream?{query}
		reverse_proxy 127.0.0.1:8090
	}
	handle {
		reverse_proxy 127.0.0.1:3001
	}
}

# Public market data (quotes, candles, WebSocket stream). Admin endpoints are never exposed.
api.kalkstrade.com {
	import common
	@admin path /v1/admin*
	respond @admin 404
	reverse_proxy 127.0.0.1:8081
}

# Website (deployed separately from the website repo on :3010)
kalkstrade.com {
	import common
	reverse_proxy 127.0.0.1:3010
}

www.kalkstrade.com {
	redir https://kalkstrade.com{uri} permanent
}
