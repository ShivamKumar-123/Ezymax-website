# Back Office (apps/admin). Copy to .env.local. All values are server-only unless prefixed NEXT_PUBLIC_.

# Rust gateway (staff sign-in, sessions, audit log, admin read APIs)
GATEWAY_URL=http://127.0.0.1:8080
GATEWAY_INTERNAL_TOKEN=<same value as GATEWAY_INTERNAL_TOKEN in the gateway env>

# Market-data service admin API (spread markups). Never exposed to the browser.
MARKET_DATA_URL=http://127.0.0.1:8081
MARKET_DATA_ADMIN_TOKEN=<same value as MARKET_DATA_ADMIN_TOKEN in the market-data env>

# Build mode: "live" (default, real data only) or "demo" (full mock showcase, no staff sign-in)
# NEXT_PUBLIC_KALKS_MODE=live

# Trading engine (services/trading): dealing desk, trading accounts, groups. Never exposed to the browser.
TRADING_URL=http://127.0.0.1:8090
TRADING_INTERNAL_TOKEN=<same value as TRADING_INTERNAL_TOKEN in the root .env.local>
# Browser URL of the dealing WebSocket. Leave unset in production: the page uses wss://<admin host>/engine/stream
# (Caddy forwards it to the engine). Locally: ws://127.0.0.1:8090/v1/dealing/stream
# TRADING_STREAM_URL=ws://127.0.0.1:8090/v1/dealing/stream

# IB / referral programme (services/ib, :8096) for the /api/partners BFF. Server-only; same value as IB_INTERNAL_TOKEN in the root .env.local
IB_URL=http://127.0.0.1:8096
IB_INTERNAL_TOKEN=<openssl rand -hex 32>
