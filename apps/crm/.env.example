# Client Area (apps/crm). Copy to .env.local (development) or .env.production.local (server).
# All values are server-only unless prefixed NEXT_PUBLIC_.

# Rust gateway (client sign-in, sessions, audit log)
GATEWAY_URL=http://127.0.0.1:8080
GATEWAY_INTERNAL_TOKEN=<same value as GATEWAY_INTERNAL_TOKEN in the gateway env>

# Google sign-in ("Continue with Google"). OAuth 2.0 client of type "Web application" in Google Cloud.
# Authorised redirect URIs on that client: https://app.kalkstrade.com/api/auth/google/callback
# (and http://localhost:3000/api/auth/google/callback for local testing).
GOOGLE_CLIENT_ID=<...apps.googleusercontent.com>
GOOGLE_CLIENT_SECRET=<GOCSPX-...>
# Shows the Google button on /login and /register. Inlined at build time: set it before `next build`.
NEXT_PUBLIC_GOOGLE_LOGIN=1

# IB / referral programme (services/ib, :8096) for the /api/partner BFF. Server-only; same value as IB_INTERNAL_TOKEN in the root .env.local
IB_URL=http://127.0.0.1:8096
IB_INTERNAL_TOKEN=<openssl rand -hex 32>

# Prop challenges (services/prop, :8097) for the /api/prop BFF and the public /verify/<code> page. Server-only; same value as PROP_INTERNAL_TOKEN in the root .env.local
PROP_URL=http://127.0.0.1:8097
PROP_INTERNAL_TOKEN=<openssl rand -hex 32>

# Academy (services/academy, :8098) for the /api/academy BFF. Server-only; same value as ACADEMY_INTERNAL_TOKEN in the root .env.local
ACADEMY_URL=http://127.0.0.1:8098
ACADEMY_INTERNAL_TOKEN=<openssl rand -hex 32>

# Wallet service (services/wallet) for the /api/wallet BFF: deposits, withdrawals, transfers. Server-only.
WALLET_URL=http://127.0.0.1:8095
WALLET_INTERNAL_TOKEN=<same value as WALLET_INTERNAL_TOKEN in the root .env.local>

# ALGO service (services/algo, :8099) for the /api/algo BFF: strategies, backtests, runtime, webhooks, API keys, marketplace. Server-only; same value as ALGO_INTERNAL_TOKEN in the root .env.local
ALGO_URL=http://127.0.0.1:8099
ALGO_INTERNAL_TOKEN=<openssl rand -hex 32>
