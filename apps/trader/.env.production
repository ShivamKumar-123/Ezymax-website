# Public brand values for production builds.
#
# NEXT_PUBLIC_* variables are inlined into the browser bundle at BUILD time, so they must be present when
# `next build` runs. None of these are secrets, so they live in the repo. A .env.local on the server overrides them.
NEXT_PUBLIC_BRAND_NAME=Ezymex
NEXT_PUBLIC_BRAND_DOMAIN=ezymex.com
NEXT_PUBLIC_SITE_URL=https://ezymex.com
NEXT_PUBLIC_BRAND_SUPPORT_EMAIL=support@ezymex.com
# Hand-offs: Ezymex Client Area (sign-in, sign-up, every signed-in page), Ezymex Trader, public market data
NEXT_PUBLIC_CRM_URL=https://app.ezymex.com
NEXT_PUBLIC_TRADER_URL=https://trade.ezymex.com
NEXT_PUBLIC_MARKET_API=https://api.ezymex.com
