# AI Trader (Toolbox > AI Trader): Claude API key, read server-side only by app/api/ai-trader/route.ts.
# Copy to .env.local and fill in. Without it the terminal uses its local rule parser.
ANTHROPIC_API_KEY=

# Gateway (services/gateway) for trade share links: server-side only (app/api/shares/*, app/share/[code]).
# Use the same values as apps/crm/.env.local.
GATEWAY_URL=http://127.0.0.1:8080
GATEWAY_INTERNAL_TOKEN=

# Trading engine (services/trading): server-side only, used by the terminal BFF (app/api/engine/*, share checks).
# Same token as TRADING_INTERNAL_TOKEN in the repo-root .env.local.
TRADING_URL=http://127.0.0.1:8090
TRADING_INTERNAL_TOKEN=
# Optional: public WebSocket URL of the account stream. Default: ws://127.0.0.1:8090/v1/terminal/stream on
# localhost, else wss://<this host>/engine/stream (Caddy forwards it to the engine).
ENGINE_STREAM_URL=

# Notifications service (services/support): server-side only, used by app/api/notifications (the title-bar bell
# shows the client's account notifications). Same token as SUPPORT_INTERNAL_TOKEN in the repo-root .env.local.
SUPPORT_URL=http://127.0.0.1:8100
SUPPORT_INTERNAL_TOKEN=

# Ezymex FX Options service (services/options): server-side only, used by the options BFF (app/api/options/*) and
# the public option chain page (app/options/chain/[underlying]). Same token as OPTIONS_INTERNAL_TOKEN in the
# repo-root .env.local (deploy.sh writes both). Trading options goes through the engine BFF (/api/engine/options/*).
OPTIONS_URL=http://127.0.0.1:8104
OPTIONS_INTERNAL_TOKEN=
# Optional: public WebSocket URL of the options chain stream. Default: ws://127.0.0.1:8104/v1/options/stream on
# localhost, else wss://<this host>/options/stream (Caddy forwards it to the options service).
OPTIONS_STREAM_URL=

# Growth service (services/growth, :8101): server-side only, used by app/api/growth/shares (the Share button on a
# closed option trade creates an options share card; its public page and PNG are in the Client Area at /s/<code>).
# Same token as GROWTH_INTERNAL_TOKEN in the repo-root .env.local (deploy.sh writes both).
GROWTH_URL=http://127.0.0.1:8101
GROWTH_INTERNAL_TOKEN=
