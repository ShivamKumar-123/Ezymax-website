<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@color/ic_launcher_background"/>
  <!-- The mark already sits inside the 66dp safe zone of its own 108dp canvas. Insetting it again here shrank it
       to 43% of the tile, which is why it read as a small shape on a black square next to other apps' icons. -->
  <foreground android:drawable="@drawable/ic_launcher_foreground"/>
  <monochrome android:drawable="@drawable/ic_launcher_monochrome"/>
</adaptive-icon>
