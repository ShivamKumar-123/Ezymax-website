{
  "expo": {
    "name": "Kalks",
    "slug": "kalks",
    "scheme": "kalks",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E0E10",
    "ios": {
      "bundleIdentifier": "com.kalkstrade.app",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.kalkstrade.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon.png",
        "backgroundColor": "#0E0E10"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      "expo-sqlite",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash.png",
          "imageWidth": 132,
          "backgroundColor": "#0E0E10",
          "resizeMode": "contain"
        }
      ],
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Kalks uses the camera to photograph your identity documents and take your verification selfie.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Kalks lets you choose a photo of your identity documents for verification.",
          "cameraPermission": "Kalks uses the camera to photograph your identity documents and take your verification selfie.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {}
    }
  }
}
