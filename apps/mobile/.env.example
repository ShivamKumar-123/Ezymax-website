# Where the app finds the Kalks Client Area BFF (/api/mobile/*). Production by default.
EXPO_PUBLIC_API_BASE=https://app.kalkstrade.com
# Local stack on a phone: start the dev relay (pnpm --filter @kalks/mobile dev-relay) and use your Mac's LAN IP:
# EXPO_PUBLIC_API_BASE=http://192.168.1.20:8790
# "Continue with Google": the app's own Google OAuth client ids (src/features/platform/README.md › Founder steps).
# Without the id of the running platform the Google button is hidden.
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# Push notifications need the EAS project id; `npx eas-cli init` writes it to app.json (extra.eas.projectId) instead.
# EXPO_PUBLIC_EAS_PROJECT_ID=
